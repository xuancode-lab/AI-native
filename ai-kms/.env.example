# 复制为 .env 并填密钥。判断层(MVP=规则集)不需要任何密钥即可跑。

# 数据位置（可选，缺省自动：exe同级 data/；exe 不可写则退 %LOCALAPPDATA%）
# KMS_DATA_ROOT=D:/MyKnowledge          # 数据根（vault/db/logs/dropbox）
# KMS_VAULT_PATH=D:/Docs/MyVault        # 仅知识文件目录（与 db 分离）

# 生成层（Claude）—— 阶段3启用
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-3-5-sonnet-20240620

# 预留：外部分类器（对应"只判断不对话"模型）
CLASSIFY_API_URL=
CLASSIFY_API_KEY=

# 预留：本地 Ollama / OpenAI（补充判断层）
OLLAMA_BASE_URL=http://localhost:11434
OPENAI_API_KEY=